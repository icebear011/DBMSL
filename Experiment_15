create or replace procedure to_month
as
v_month varchar2(5);
begin
v_month: to_char(sysdate, 'MON');
dbms_output.put_line('the current month is || v_month);
end;
/

create or replace procedure to month
as
v_month varchar2(10);
begin
v month: to char(sysdate, MONTH);
end;

create or replace procedure to_DAY
as
v_day varchar2(10);
begin
v_day: to_char(sysdate, 'dy');
dbms_output.put_line('the current month is || v_day);
end;
/



create or replace procedure to_DAY
as
v_day varchar2(10);
begin
v_day := to_char(sysdate, 'day');
dbms_output.put_line('the current month is || v_day);
end;
/



create or replace procedure to_DAY
as
v_day varchar2(10);
