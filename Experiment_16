CREATE OR REPLACE TRIGGER trg_salary_check
BEFORE INSERT ON emp
FOR EACH ROW
DECLARE
    min_sal NUMBER;
    max_sal NUMBER;
BEGIN
    
    SELECT MIN(salary), MAX(salary)
    INTO min_sal, max_sal
    FROM emp;

    IF :NEW.salary > (10 * min_sal) THEN
        RAISE_APPLICATION_ERROR(-20003, 
        'Salary too high (more than 10 times minimum salary)');

    ELSIF :NEW.salary < (max_sal / 10) THEN
        RAISE_APPLICATION_ERROR(-20004, 
        'Salary too low (less than 1/10th of maximum salary)');
    END IF;
END;
/
