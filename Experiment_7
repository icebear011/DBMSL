CREATE OR REPLACE FUNCTION display_1_to_10
RETURN VARCHAR2
IS
    v_counter NUMBER := 1;
    v_output  VARCHAR2(200) := '';
BEGIN
    WHILE v_counter <= 10 LOOP
        v_output := v_output || v_counter || ' ';
        v_counter := v_counter + 1;
    END LOOP;

    RETURN v_output;
END;
/




BEGIN
   DBMS_OUTPUT.PUT_LINE(display_1_to_10);
END;
