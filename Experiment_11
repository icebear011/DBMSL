
CREATE OR REPLACE FUNCTION reverse_it(x IN INT) RETURN INT AS
  z INT;
  rev INT := 0;
  r INT;
BEGIN
  WHILE x > 0 LOOP
    r := MOD(x, 10);
    rev := (rev * 10) + r;
    x := TRUNC(x / 10);
  END LOOP;
  
  z := rev;
  RETURN z;
END;
/


BEGIN
  DECLARE a INT := 123456789;
  DECLARE c INT;
  
  c := reverse_it(a);
  DBMS_OUTPUT.put_line('The reverse of number is ' || c);
END;
/
